        {
          "id": "7f19142c-aed6-4d46-9ded-742bf732ec1a",
          "name": "CubeFS Add a data node",
          "request": {
            "name": "CubeFS Add a data node",
            "description": {
              "content": "Registers a new data node with the cluster at the specified address. The data node must already be running and accessible at the given address before it can be added to the cluster.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dataNode",
                "add"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "addr",
                  "value": "<string>",
                  "description": "(Required) Address of the data node in host:port format."
                }
              ],
              "variable": [
                {
                  "description": "IP address or hostname of the CubeFS Master node.",
                  "type": "any",
                  "value": "{{masterHost}}",
                  "key": "masterHost"
                },
                {
                  "description": "Listening port of the CubeFS Master node.",
                  "type": "any",
                  "value": "{{masterPort}}",
                  "key": "masterPort"
