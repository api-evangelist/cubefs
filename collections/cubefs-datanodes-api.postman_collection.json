        {
          "id": "604d0d9d-e5f2-42e5-8a48-1e7c9eecc3f3",
          "name": "CubeFS Decommission a data node",
          "request": {
            "name": "CubeFS Decommission a data node",
            "description": {
              "content": "Removes a data node from the cluster. All data partitions on the node are asynchronously migrated to other available data nodes before the node is fully removed. This is a safe operation for draining a node during maintenance or replacement.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dataNode",
                "decommission"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "addr",
                  "value": "<string>",
                  "description": "(Required) Address of the data node to decommission in host:port format."
                }
              ],
              "variable": [
                {
                  "description": "IP address or hostname of the CubeFS Master node.",
                  "type": "any",
                  "value": "{{masterHost}}",
                  "key": "masterHost"
