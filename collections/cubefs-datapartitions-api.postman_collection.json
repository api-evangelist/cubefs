          "id": "10db8d5b-997d-4c23-9443-c302f8bda620",
          "name": "CubeFS Create a data partition",
          "request": {
            "name": "CubeFS Create a data partition",
            "description": {
              "content": "Manually creates a data partition for a specific volume. This is typically done automatically by the Master when volume usage exceeds thresholds, but can be triggered manually when the cluster is frozen or for operational purposes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dataPartition",
                "create"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "count",
                  "value": "<integer>",
                  "description": "(Required) Number of data partitions to create."
                },
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "(Required) Name of the volume to create data partitions for."
                }
              ],
              "variable": [
                {
                  "description": "IP address or hostname of the CubeFS Master node.",
                  "type": "any",
                  "value": "{{masterHost}}",
                  "key": "masterHost"
                },
                {
                  "description": "Listening port of the CubeFS Master node.",
                  "type": "any",
                  "value": "{{masterPort}}",
                  "key": "masterPort"
                }
              ]
            },
