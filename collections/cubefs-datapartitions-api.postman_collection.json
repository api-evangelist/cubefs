          "id": "bef394b7-e817-4ff9-8934-a8280c4291c8",
          "name": "CubeFS Decommission a data partition",
          "request": {
            "name": "CubeFS Decommission a data partition",
            "description": {
              "content": "Migrates a specific data partition from a given data node to another available data node. Used to drain a node before decommissioning or to rebalance data distribution.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dataPartition",
                "decommission"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<integer>",
                  "description": "(Required) ID of the data partition to decommission."
                },
                {
                  "disabled": false,
                  "key": "addr",
                  "value": "<string>",
                  "description": "(Required) Address of the data node hosting the partition to migrate away from."
                }
              ],
              "variable": [
                {
                  "description": "IP address or hostname of the CubeFS Master node.",
