          "name": "CubeFS Add a metadata node",
          "request": {
            "name": "CubeFS Add a metadata node",
            "description": {
              "content": "Registers a new metadata node with the cluster at the specified address. The metadata node must already be running and accessible before it can join the cluster.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "metaNode",
                "add"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "addr",
                  "value": "<string>",
                  "description": "(Required) Address of the metadata node in host:port format."
                }
              ],
              "variable": [
                {
                  "description": "IP address or hostname of the CubeFS Master node.",
                  "type": "any",
                  "value": "{{masterHost}}",
                  "key": "masterHost"
                },
                {
                  "description": "Listening port of the CubeFS Master node.",
                  "type": "any",
                  "value": "{{masterPort}}",
