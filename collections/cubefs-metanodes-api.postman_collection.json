          "name": "CubeFS Decommission a metadata node",
          "request": {
            "name": "CubeFS Decommission a metadata node",
            "description": {
              "content": "Removes a metadata node from the cluster. All metadata partitions on the node are asynchronously migrated to other available metadata nodes before the node is fully removed.",
              "type": "text/plain"
            },
