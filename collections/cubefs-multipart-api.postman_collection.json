          "request": {
            "name": "CubeFS Upload a part",
            "description": {
              "content": "Uploads a single part in a multipart upload. Parts must be between 5 MB and 5 GB. The part number must be between 1 and 10,000. Returns an ETag for the part that must be included when completing the upload.",
