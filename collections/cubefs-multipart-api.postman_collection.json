      "name": "Multipart",
      "description": {
        "content": "Multipart upload operations for uploading large objects in parts. Supports initiating, uploading parts, listing parts, completing, and aborting multipart uploads.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "803bbae5-51df-4dd9-8285-aba9851acef3",
          "name": "CubeFS Initiate a multipart upload",
          "request": {
            "name": "CubeFS Initiate a multipart upload",
            "description": {
              "content": "Initiates a multipart upload session for a large object. Returns an UploadId that must be included in all subsequent part upload, list, complete, and abort requests for this multipart upload.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":bucket",
                "{{key}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "uploads",
                  "value": "null"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "bucket",
                  "description": "(Required) Name of the S3 bucket (corresponds to a CubeFS volume name)."
                },
                {
                  "description": "IP address or hostname of the CubeFS Master node.",
                  "type": "any",
                  "value": "{{masterHost}}",
                  "key": "masterHost"
                },
                {
                  "description": "Listening port of the CubeFS Master node.",
                  "type": "any",
                  "value": "{{masterPort}}",
