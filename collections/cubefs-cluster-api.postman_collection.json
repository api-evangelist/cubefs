        {
          "id": "53b33a75-07c9-45ff-9518-b130a265cab3",
          "name": "CubeFS Freeze or unfreeze the cluster",
          "request": {
            "name": "CubeFS Freeze or unfreeze the cluster",
            "description": {
              "content": "Freezes or unfreezes the cluster. When frozen, volumes will no longer automatically create data or metadata partitions. This is used during maintenance operations to prevent new partition creation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "cluster",
                "freeze"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "enable",
                  "value": "<string>",
                  "description": "(Required) Set to true to freeze the cluster or false to unfreeze it."
                }
              ],
              "variable": [
                {
                  "description": "IP address or hostname of the CubeFS Master node.",
                  "type": "any",
                  "value": "{{masterHost}}",
