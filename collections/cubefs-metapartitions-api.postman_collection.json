        {
          "id": "f03b8ec6-f771-4505-8acc-a6af3a06544c",
          "name": "CubeFS Decommission a metadata partition",
          "request": {
            "name": "CubeFS Decommission a metadata partition",
            "description": {
              "content": "Migrates a metadata partition from a given metadata node to another available node. Used to drain a metadata node before decommissioning or to rebalance metadata distribution.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "metaPartition",
                "decommission"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<integer>",
                  "description": "(Required) ID of the metadata partition to decommission."
                },
                {
                  "disabled": false,
                  "key": "addr",
                  "value": "<string>",
                  "description": "(Required) Address of the metadata node hosting the partition."
                }
              ],
              "variable": [
                {
                  "description": "IP address or hostname of the CubeFS Master node.",
                  "type": "any",
                  "value": "{{masterHost}}",
