          "name": "CubeFS Create a metadata partition",
          "request": {
            "name": "CubeFS Create a metadata partition",
            "description": {
              "content": "Manually creates a metadata partition for a specific volume. This is typically triggered when existing metadata partitions approach their inode count limits, but can also be done manually.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "metaPartition",
                "create"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "(Required) Name of the volume to create metadata partitions for."
                }
              ],
              "variable": [
                {
                  "description": "IP address or hostname of the CubeFS Master node.",
                  "type": "any",
                  "value": "{{masterHost}}",
                  "key": "masterHost"
                },
                {
                  "description": "Listening port of the CubeFS Master node.",
